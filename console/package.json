{
  "name": "rua-console",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "build": "npm run typecheck && vite build",
    "build:desktop-bootstrap": "npm run typecheck && vite build --config src-tauri/vite.bootstrap.config.ts",
    "build:prod": "npm run typecheck && vite build --mode production",
    "build:test": "npm run typecheck && vite build --mode test",
    "format": "npm run typecheck -- --noEmit && prettier --write .",
    "format:check": "npm run typecheck -- --noEmit && prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "preview:test": "vite preview --mode test",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "e2e": "playwright test --config playwright.e2e.config.ts",
    "e2e:headed": "playwright test --config playwright.e2e.config.ts --headed",
    "e2e:report": "playwright show-report playwright-report",
    "test:terminal-compat": "playwright test --config playwright.terminal.config.ts",
    "test": "vitest run",
    "desktop:before-dev": "cargo build --manifest-path ../Cargo.toml -p rua-cli && python3 ../scripts/ci/stage-desktop-automation.py --profile dev --runtime ../target/debug/rua && npm run build && vite --config src-tauri/vite.bootstrap.config.ts",
    "desktop:dev": "tauri dev --config src-tauri/tauri.conf.json"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "i18next": "^25.8.4",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.6.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "intersection-observer": "npm:empty-npm-package@^1",
    "intl-messageformat": {
      ".": "npm:empty-npm-package@^1",
      "intl-messageformat-parser": "npm:empty-npm-package@^1"
    },
    "intl-messageformat-parser": "npm:empty-npm-package@^1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/i18next": "^12.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "less": "^4.5.1",
    "prettier": "3.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.30.1",
    "undici": "7.25.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.6"
  },
  "repository": "https://github.com/buggiant-coder/Rua"
}
