+// Only Rua's private daemon namespace enables this lifecycle. The stop file
+// remains set until the daemon has acknowledged exit, so reconnect cannot revive input.
+async fn rua_owner_closed() {
+    let Some(owner_file) = env::var_os("RUA_BROWSER_OWNER_FILE").map(PathBuf::from) else {
+        return std::future::pending::<()>().await;
+    };
+    let session = env::var("AGENT_BROWSER_SESSION").unwrap_or_default();
+    let stop_file = get_daemon_socket_dir().join(format!("{session}.stop"));
+    let owner_pid = env::var("RUA_BROWSER_OWNER_PID").ok().and_then(|p|p.parse::<u32>().ok());
+    loop {
+        if !owner_file.exists() || stop_file.exists()
+            || owner_pid.is_some_and(|pid|!crate::connection::is_pid_alive(pid)) {
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+}
+
+async fn rua_close(state: &mut DaemonState) {
+    // Dropping an owned ChromeProcess closes its process group/Windows Job.
+    let _ = tokio::time::timeout(Duration::from_secs(3), close_all_browser_backends(state)).await;
+    state.browser.take();
+}
 
